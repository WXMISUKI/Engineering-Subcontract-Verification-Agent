  "scope_keywords": ["工程范围", "承包范围", "分包范围", "工程内容", "工作内容"],
  "party_name_regex": "(甲方|发包人|建设单位|总承包人|乙方|分包人|分包单位|承包人)[:：]\\s*([^\\s，。；、,;；]{2,40}?(?:有限公司|有限责任公司|集团有限公司|工程公司|公司))",
  "uscc_regex": "[0-9A-HJ-NPQRTUWXY]{18}",
