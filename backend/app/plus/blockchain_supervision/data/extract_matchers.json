  "date_regex": "(\\d{4})\\s*年\\s*(\\d{1,2})\\s*月\\s*(\\d{1,2})\\s*日|(\\d{4})-(\\d{1,2})-(\\d{1,2})",
  "mgmt_fee_keyword": "管理费",
  "mgmt_fee_ratio_regex": "管理费[^0-9%％]{0,12}(\\d+(?:\\.\\d+)?)\\s*[%％]",
