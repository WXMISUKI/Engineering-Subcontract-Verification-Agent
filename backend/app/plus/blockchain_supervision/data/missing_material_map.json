{
  "meta": {
    "name": "缺件 → 材料类归并映射（BS-P1-12 / BS-P1-06 前置）",
    "note": "规则=数据：把结构化缺件 key 归并到「该补哪一份材料」的有限集合。改动走本文件，可 diff、可回滚，不写死在代码里。本文件**不进库**——库里只存 key，中文标签与归并关系都在这里现读，所以改文案不会让已落库结论失效。",
    "source_note": "材料类依据《2025 年分包报审资料附件要求》与 118 号文附件 1 的报审资料分类拟定；key 取自 data/transfer_rules.json 的 required_evidence 字段（同名即同义，不另造 key）。",
    "why": "缺件若只存在 message 文案里，面板只能靠正则拆（实测嵌套中文括号 `全部工程覆盖（肢解/分别发包）明文` 必被截断），且 BS-P1-02 已改过一次缺件文案 ⇒ 文案一改面板就坏。故落 missing_json 存 key，材料类归并由本文件承担。"
  },
  "material_categories": {
    "general_contract": {
      "label": "总包合同",
      "hint": "总包（承包）合同，含合同金额、承包范围、双方主体、签字盖章",
      "roles": ["general"]
    },
    "sub_contract": {
      "label": "分包合同",
      "hint": "拟分包的施工合同，含分包范围、金额、双方主体",
      "roles": ["sub"]
    },
    "labor_contract": {
      "label": "劳务合作合同",
      "hint": "劳务合作/劳务分包合同，含劳务范围、计费与价款条款",
      "roles": ["labor"]
    },
    "certificates": {
      "label": "证照",
      "hint": "营业执照、资质证书、安全生产许可证（需在有效期内）",
      "roles": ["cert", "packet"]
    },
    "personnel_social": {
      "label": "人员与社保证明",
      "hint": "派驻人员名单、主要管理人员名单、劳动合同、社保缴纳证明（含统计期间）",
      "roles": ["person", "packet"]
    },
    "procurement_lease": {
      "label": "采购与租赁凭证",
      "hint": "主要材料/周转材料的采购合同、租赁合同、发票与供应商主体",
      "roles": ["packet"]
    },
    "fund_flow": {
      "label": "资金流凭证",
      "hint": "工程款收付流水、发票流，含统计期间与扣费转拨关系",
      "roles": ["fund", "packet"]
    },
    "supervision_consent": {
      "label": "监理审查与发包人同意",
      "hint": "监理审查意见、发包人书面同意文件（含同意日期）",
      "roles": ["packet"]
    },
    "joint_venture": {
      "label": "联合体协议",
      "hint": "联合体协议与内部分工约定",
      "roles": ["packet"]
    },
    "plan_and_signature": {
      "label": "方案编制与署名",
      "hint": "施工组织设计/专项方案，含编制主体署名与责任条款",
      "roles": ["packet"]
    },
    "submission_packet": {
      "label": "分包报审附件",
      "hint": "按主体补充分包报审包中明确缺少的附件或组合子件",
      "roles": ["packet", "sub", "labor"]
    },
    "statutory_authority": {
      "label": "法规明文与认定标准",
      "hint": "兜底条款所需的法规明文与确定性认定标准——不是可提交的材料，须由有权口径补充",
      "roles": []
    },
    "review_output": {
      "label": "审查产出或人工作判（非补件）",
      "hint": "这类缺口不是「少交一份材料」：可能是本系统尚未产出的核查结论、两份材料的对照判断、或只能由人工/有权口径确认的定性。补件补不上，需在工作台走人工确认",
      "roles": []
    }
  },
