# 仅为候选配置说明。复制为 .env 后填写，切勿提交真实密钥。
# DATABASE_URL 使用独立数据库 bs_review；密码中的特殊字符需 URL 编码。
DATABASE_URL=
SECRET_KEY=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
KNOWLEDGE_DB_PASSWORD=
KNOWLEDGE_REDIS_PASSWORD=
KNOWLEDGE_JWT_SECRET=
# 必须为 32 字节，固定保存，否则知识服务已加密数据无法解密。
KNOWLEDGE_AES_KEY=
# 仅在可信模型地址需要时填写精确域名；默认不放宽网络访问检查。
KNOWLEDGE_SSRF_WHITELIST_EXTRA=
WEKNORA_API_KEY=
# 用于一次性初始化命令，部署时外置，不加入镜像或版本控制。
WEKNORA_ADMIN_EMAIL=
WEKNORA_ADMIN_PASSWORD=
WEKNORA_ADMIN_USERNAME=
WEKNORA_EMBEDDING_MODEL_ID=
WEKNORA_VLM_MODEL_ID=
EMBEDDING_MODEL=
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=
KNOWLEDGE_VLM_MODEL=
KNOWLEDGE_VLM_API_BASE=
KNOWLEDGE_VLM_API_KEY=
BS_WEKNORA_KB_MAP=
# 可选 legacy 或 moma；两条链路分别配置。
BS_OPTIONAL_SOURCE_SCOPE_LIMITATIONS_ENABLED=false
LLM_PROVIDER=legacy
LLM_MODEL=
LLM_API_BASE=
LLM_API_KEY=
OCR_CLOUD_PROVIDER=legacy
OCR_CLOUD_MODEL=
OCR_CLOUD_ENDPOINT=
OCR_CLOUD_API_KEY=
# 默认仅本机监听；COOKIE_SECURE=true 需要 HTTPS。
BS_BIND_ADDRESS=127.0.0.1
BS_PORT=8088
COOKIE_SECURE=true
