# 独立分包后端；当前仍需完成知识初始化和业务验收。
FROM python:3.13-slim@sha256:ae14d4ce8771606477a81446e7ef429edd6762305fc50c84507c1041fa8285d1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY backend/app /app/app
COPY knowledge/seed-manifest.json /app/knowledge/seed-manifest.json
RUN useradd --create-home --uid 10001 bsapp && mkdir -p /data /app/app/uploads \
    && chown bsapp:bsapp /data /app/app/uploads
USER bsapp
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
EXPOSE 8000
CMD ["uvicorn", "app.standalone.asgi:app", "--host", "0.0.0.0", "--port", "8000"]
